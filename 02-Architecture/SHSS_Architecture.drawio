<mxfile host="app.diagrams.net" type="device"><diagram id="arch" name="SHSS Architecture"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Smart Home Security System (SHSS) — System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1690" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Hybrid model: local-first control on the Central Control Unit (CCU); cloud is used only for remote access, push notifications, identity, backup and updates" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1690" height="18" as="geometry"/></mxCell><mxCell id="lan" value="Home Premises (LAN)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=4;fontStyle=1;startSize=28;fontSize=13;fillColor=#E0E0E0;strokeColor=#616161;swimlaneFillColor=#FAFAFA;fontSize=15;startSize=32;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1230" height="870" as="geometry"/></mxCell><mxCell id="sens" value="Sensors (Zigbee 3.0)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=4;fontStyle=1;startSize=28;fontSize=13;fillColor=#B9DDB4;strokeColor=#5E9E52;swimlaneFillColor=#EAF5E8;" vertex="1" parent="lan"><mxGeometry x="15" y="40" width="250" height="440" as="geometry"/></mxCell><mxCell id="s_pir" value="PIR motion sensor (pet-immune)&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery powered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#5E9E52;" vertex="1" parent="sens"><mxGeometry x="15" y="38" width="220" height="58" as="geometry"/></mxCell><mxCell id="s_door" value="Door / window magnetic contact&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery powered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#5E9E52;" vertex="1" parent="sens"><mxGeometry x="15" y="108" width="220" height="58" as="geometry"/></mxCell><mxCell id="s_leak" value="Water leak sensor&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery powered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#5E9E52;" vertex="1" parent="sens"><mxGeometry x="15" y="178" width="220" height="58" as="geometry"/></mxCell><mxCell id="s_glass" value="Glass-break acoustic sensor&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery powered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#5E9E52;" vertex="1" parent="sens"><mxGeometry x="15" y="248" width="220" height="58" as="geometry"/></mxCell><mxCell id="s_smoke" value="Smoke / CO detector&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery powered&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#5E9E52;" vertex="1" parent="sens"><mxGeometry x="15" y="318" width="220" height="58" as="geometry"/></mxCell><mxCell id="sens_note" value="All sensors join the Zigbee 3.0 mesh; mains-powered Zigbee devices (plugs, lights) act as mesh routers" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="sens"><mxGeometry x="10" y="388" width="230" height="44" as="geometry"/></mxCell><mxCell id="cams" value="Cameras (PoE / Ethernet)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=4;fontStyle=1;startSize=28;fontSize=13;fillColor=#BBD3F2;strokeColor=#4A78B5;swimlaneFillColor=#E8F0FA;" vertex="1" parent="lan"><mxGeometry x="15" y="500" width="250" height="330" as="geometry"/></mxCell><mxCell id="c_in" value="Indoor PoE IP camera&lt;br&gt;&lt;i&gt;ONVIF/RTSP · 1080p–4K · IR night vision&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#4A78B5;" vertex="1" parent="cams"><mxGeometry x="15" y="38" width="220" height="58" as="geometry"/></mxCell><mxCell id="c_out" value="Outdoor PoE IP camera&lt;br&gt;&lt;i&gt;ONVIF/RTSP · 4K · IR night vision · IP66&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#4A78B5;" vertex="1" parent="cams"><mxGeometry x="15" y="108" width="220" height="58" as="geometry"/></mxCell><mxCell id="c_bell" value="Video doorbell (PoE)&lt;br&gt;&lt;i&gt;ONVIF/RTSP · 2-way audio&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#4A78B5;" vertex="1" parent="cams"><mxGeometry x="15" y="178" width="220" height="58" as="geometry"/></mxCell><mxCell id="poesw" value="PoE switch (802.3at), on UPS&lt;br&gt;&lt;i&gt;Cat6 Ethernet to cameras · GbE uplink to CCU&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="cams"><mxGeometry x="15" y="258" width="220" height="56" as="geometry"/></mxCell><mxCell id="ccu" value="Central Control Unit — Smart Home Manager (local server)" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=4;fontStyle=1;startSize=28;fontSize=13;fillColor=#FFE599;strokeColor=#BF9000;swimlaneFillColor=#FFF8E1;" vertex="1" parent="lan"><mxGeometry x="415" y="40" width="470" height="470" as="geometry"/></mxCell><mxCell id="ccu_hw" value="Hardware: Raspberry Pi 5 / Intel N100 mini PC, Linux — the Smart Home Manager software stack runs as Docker containers" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="ccu"><mxGeometry x="15" y="32" width="440" height="40" as="geometry"/></mxCell><mxCell id="rules" value="Core / Rules &amp;amp; Alarm Engine&lt;br&gt;&lt;i&gt;arming, zones, alarm logic, automations&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#BF9000;" vertex="1" parent="ccu"><mxGeometry x="15" y="78" width="215" height="52" as="geometry"/></mxCell><mxCell id="api" value="REST + WebSocket API server&lt;br&gt;&lt;i&gt;HTTPS / WSS · local and remote clients&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#BF9000;" vertex="1" parent="ccu"><mxGeometry x="240" y="78" width="215" height="52" as="geometry"/></mxCell><mxCell id="mqtt" value="MQTT broker (Mosquitto)&lt;br&gt;&lt;i&gt;device event bus&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#BF9000;" vertex="1" parent="ccu"><mxGeometry x="15" y="140" width="215" height="52" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL database&lt;br&gt;&lt;i&gt;configuration, users, event log&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#BF9000;" vertex="1" parent="ccu"><mxGeometry x="240" y="140" width="215" height="52" as="geometry"/></mxCell><mxCell id="zig" value="Zigbee 3.0 coordinator (USB dongle)&lt;br&gt;&lt;i&gt;sensor and actuator mesh network&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="ccu"><mxGeometry x="15" y="202" width="440" height="52" as="geometry"/></mxCell><mxCell id="nvr" value="NVR / Video service&lt;br&gt;&lt;i&gt;RTSP/ONVIF ingest, motion clips&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#BF9000;" vertex="1" parent="ccu"><mxGeometry x="15" y="270" width="215" height="52" as="geometry"/></mxCell><mxCell id="ssd" value="Local storage: 2 TB SSD&lt;br&gt;&lt;i&gt;30-day video retention, encrypted&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" paren