ry"/></mxCell><mxCell id="u_pad" value="Wall-mounted keypad / touch panel&lt;br&gt;&lt;i&gt;PoE Ethernet or Wi-Fi&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#8E6AA6;" vertex="1" parent="ui"><mxGeometry x="10" y="38" width="180" height="58" as="geometry"/></mxCell><mxCell id="u_mob" value="Mobile app (iOS / Android)&lt;br&gt;&lt;i&gt;on home Wi-Fi&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#8E6AA6;" vertex="1" parent="ui"><mxGeometry x="10" y="108" width="180" height="58" as="geometry"/></mxCell><mxCell id="u_web" value="Web dashboard in browser&lt;br&gt;&lt;i&gt;laptop / PC on LAN&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#8E6AA6;" vertex="1" parent="ui"><mxGeometry x="10" y="178" width="180" height="58" as="geometry"/></mxCell><mxCell id="u_voice" value="Voice assistant / key fob, NFC tag&lt;br&gt;&lt;i&gt;optional&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#8E6AA6;" vertex="1" parent="ui"><mxGeometry x="10" y="248" width="180" height="58" as="geometry"/></mxCell><mxCell id="act" value="Controllers / Actuators" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;rounded=1;arcSize=4;fontStyle=1;startSize=28;fontSize=13;fillColor=#F4B6B3;strokeColor=#B85450;swimlaneFillColor=#FBEAE8;" vertex="1" parent="lan"><mxGeometry x="1015" y="430" width="200" height="400" as="geometry"/></mxCell><mxCell id="a_lock" value="Smart door lock&lt;br&gt;&lt;i&gt;Zigbee 3.0 · battery&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#FFFFFF;strokeColor=#B85450;" vertex="1" parent="act"><mxGeometry x="10" y="38" width="180" height="58" as="geometry"/></mxCell><mxCell id="a_light" value="Smart lights &amp;amp; plugs&lt;br&gt;&lt;i&gt;Zigbee 3.0 · mains (mesh router)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;htm